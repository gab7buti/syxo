{
  "buildCommand": "echo 'Static site'",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/dashboard/?$",
      "dest": "/dashboard.html"
    },
    {
      "src": "/login/?$",
      "dest": "/login.html"
    },
    {
      "src": "/?$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
